{
  // cs2ac gamedata - s2sdk gamedata format (same schema as the s2sdk plugin's own gamedata.jsonc),
  // loaded via s2sdk LoadGameConfigFile / GetGameConfigSignature from configs/cs2ac/gamedata.jsonc
  // (or next to the plugin binary).
  //
  // Source: the CS2AC 1.0.14 gamedata (cs2ac.games.txt by karola3vax); the addon runs its own copy
  // at addons/cs2ac/gamedata/cs2ac.games.txt, and the linux patterns below are byte-for-byte those
  // entries. SourceMod's wildcard byte (\x2A) is written as "?" in this format.
  //
  // NOT verified against the game binary: run `cs2ac_hooks` on the server and confirm every entry
  // reports "resolved". A signature that does not match this build simply
  // leaves its feature off (hook installation is fail-soft), which is why the port also samples
  // the movement data per frame instead of depending on these patterns.
  //
  // win64 patterns are carried over unchanged for reference; this port is Linux-only.
  "$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify-plugin-s2sdk/refs/heads/main/schemas/gamedata.schema.json",
  "csgo": {
    "Signatures": {
      // "%sRecv usercmd %d.  Margin:%5.1fms net +%2d queue =%5.1f"
      // Hooked: the usercmd stream every detector consumes.
      "ProcessUsercmds": {
        "library": "server",
        "win64": "48 8B C4 44 88 48 20 44 89 40 18 48 89 50 10 53",
        "linuxsteamrt64": "55 48 89 E5 41 57 41 56 41 55 41 54 53 48 89 FB 48 83 EC 48 89 4D"
      },
      // Hooked: the authoritative per-tick command (Aimlock/Aimbot/Triggerbot/ShotCorrelator).
      "SetupMove": {
        "library": "server",
        "win64": "40 53 56 48 83 EC 78 48 89 6C 24 70",
        "linuxsteamrt64": "55 48 89 E5 41 57 41 56 41 55 49 89 F5 41 54 49 89 D4 53 48 89 FB 48 83 EC 48 E8 ? ? ? ? 48 8B 43 38"
      },
      // Resolved for the `cs2ac_hooks` report only; the port samples the same data per frame.
      "ProcessMovement": {
        "library": "server",
        "win64": "40 57 41 57 48 81 EC B8 00 00 00",
        "linuxsteamrt64": "55 48 89 E5 41 57 41 56 41 55 49 89 F5 41 54 53 48 89 FB 48 83 EC ? 48 8B 7F"
      },
      "Duck": {
        "library": "server",
        "win64": "48 8B C4 55 53 56 57 41 56 41 57 48 8D A8 ? ? ? ? 48 81 EC ? ? ? ? 80 B9",
        "linuxsteamrt64": "55 48 89 E5 41 57 41 56 49 89 FE 41 55 41 54 53 48 89 F3 48 81 EC ? ? ? ? 48 8D 05 ? ? ? ? F3 0F 10 05"
      },
      "LadderMove": {
        "library": "server",
        "win64": "40 55 53 56 57 41 57 48 8D AC 24 ? ? ? ? 48 81 EC ? ? ? ? 48 8B F9",
        "linuxsteamrt64": "48 B8 ? ? ? ? ? ? ? ? 55 66 0F EF C0 48 89 E5 41 57 41 56 41 55 4C 8D AD ? ? ? ? 41 54 49 89 F4"
      },
      "OnJumpLegacy": {
        "library": "server",
        "win64": "40 55 53 56 57 48 8D 6C 24 ? 48 81 EC ? ? ? ? 48 8B 59",
        "linuxsteamrt64": "55 48 89 E5 41 57 41 56 41 55 49 89 F5 41 54 53 48 89 FB 48 83 EC 18 4C 8B 67 38 4D 85 E4"
      },
      "OnJumpModern": {
        "library": "server",
        "win64": "40 55 56 57 41 56 48 8D 6C 24 ? 48 81 EC ? ? ? ? 4C 8B 71",
        "linuxsteamrt64": "55 48 89 E5 41 57 41 56 41 55 49 89 F5 41 54 53 48 89 FB 48 81 EC ? ? ? ? 4C 8B 77 ? 4D 8B 66"
      },
      "AirMove": {
        "library": "server",
        "win64": "48 8B C4 53 55 56 57 48 81 EC ? ? ? ? 0F 29 70",
        "linuxsteamrt64": "55 48 8D 15 ? ? ? ? 48 89 E5 41 57 41 56 4C 8D B5 ? ? ? ? 41 55 4C 89 F1 41 54 41"
      },
      "AirAccelerate": {
        "library": "server",
        "win64": "F3 0F 11 5C 24 20 53 56 57 48 83 EC 60",
        "linuxsteamrt64": "55 48 89 E5 41 55 49 89 D5 41 54 49 89 FC 53 48 89 F3 48 83 EC 18 48 8B 7F 38"
      },
      // CCSPlayer_MovementServices::WalkMove — the old CS2AC 1.0.14 pattern (and the win64 one
      // above) no longer match the shipping build: the prologue's lea target and the following
      // instruction changed. This pattern comes from the SwiftlyS2 signature set for the same
      // build ("CCSPlayer_MovementServices::WalkMove") and matches libserver.so exactly once (file
      // offset 22900848 = VA 0x15D8070), the disassembly there is the WalkMove prologue
      // (`movabs rax, 0x3F80000000000000` = the float 1.0; push rbp; pxor xmm0,xmm0; push
      // r15/r14; lea -0x218(%rbp),%r15; push r13; mov %rsi,%r13), and the sibling entries from the
      // same set resolve in the same binary (CCSPlayer_MovementServices::FullWalkMove at
      // 22907056, i.e. 0x1840 bytes after WalkMove, and ::Friction at 22599616 - both exactly one
      // match each), which is what pins the source to this game version.
      "WalkMove": {
        "library": "server",
        "win64": "48 8B C4 48 89 70 ? 48 89 78 ? 55 41 54 41 55 41 56 41 57 48 8D A8 ? ? ? ? 48 81 EC ? ? ? ? 0F 29 70 ? 48 8B F1",
        "linuxsteamrt64": "48 B8 00 00 00 00 00 00 80 3F 55 66 0F EF C0 48 89 E5 41 57 41 56 4C 8D BD ? ? ? ? 41 55 49 89 F5"
      },
      "TryPlayerMove": {
        "library": "server",
        "win64": "48 8B C4 4C 89 48 ? 4C 89 40 ? 48 89 50 ? 48 89 48 ? 55 53 56 57 41 54 41 55 41 56 41 57 48 8D A8 ? ? ? ? 48 81 EC ? ? ? ? 0F 29 70",
        "linuxsteamrt64": "48 B8 ? ? ? ? ? ? ? ? 55 66 0F EF C0 48 89 E5 41 57 41 56 49 89 F6"
      },
      "CategorizePosition": {
        "library": "server",
        "win64": "40 55 56 57 41 54 41 55 48 8D AC 24 ? ? ? ? 48 81 EC ? ? ? ? 48 8B F9",
        "linuxsteamrt64": "48 B8 ? ? ? ? ? ? ? ? 55 66 0F EF C0 48 89 E5 41 57 41 56 41 55 41 89 D5"
      },
      "PhysicsSimulate": {
        "library": "server",
        "win64": "40 55 53 56 57 41 55 41 56 48 8D AC 24 08 F9 FF FF",
        "linuxsteamrt64": "55 ? ? ? ? ? ? ? ? ? ? ? ? ? ? 48 89 E5 41 57 41 56 41 55 41 54 53 48 89 FB 48 8D 3D ? ? ? ? 48 81 EC ? 00 00 00"
      },
      "GameEventManager": {
        "library": "server",
        "win64": "48 8D 0D ? ? ? ? 49 8B 04 38",
        "linuxsteamrt64": "4C 8D 25 ? ? ? ? 31 DB 48 83 EC 08"
      },
      // CSource2GameClients::StartHLTVServer: game event %s not found.
      // Function right before the first virtual function call.
      "GetLegacyGameEventListener": {
        "library": "server",
        "win64": "48 8B 15 ? ? ? ? 48 85 D2 74 ? 85 C9",
        "linuxsteamrt64": "48 8B 05 ? ? ? ? 48 85 C0 74 ? 83 FF ? 77 ? 48 63 FF 48 C1 E7 ? 48 8D 44 38"
      }
    },
    "Offsets": {
      // The engine userid the {userid} punishment placeholder needs, read from the client object
      // s2sdk::PlayerSlotToClientPtr returns (CServerSideClientBase*, the type s2sdk's own
      // GetClientBySlot declares for the client list).
      //
      // 168 is the CServerSideClientBase::m_UserID offset for this build: SwiftlyS2's offsets for
      // the same game version list "CServerSideClientBase::m_UserID: linux 168", and the
      // neighbouring members it lists (m_UserIDString 56, m_Name 64, m_nClientSlot 72,
      // m_nSignonState 100, m_bFakePlayer 160) match the Metamod header's layout (its
      // CServerSideClient header annotations), whose linux column is consistently these values
      // plus the 16 bytes that header models for the linux base-subobject offset
      // (m_Name 80 = 64 + 16, m_UserID 184 = 168 + 16, ...) - i.e. the two
      // sources agree once that shift is accounted for, and s2sdk's client pointer is typed
      // CServerSideClientBase*, so the base-relative 168 is the right one for this port.
      //
      // Because a wrong userid would substitute the WRONG PLAYER into a kick command, the plugin
      // never trusts this offset blindly: engine::PlayerUserId() only uses it after it agreed with
      // a userid the engine itself reported in a game event for the same player
      // (engine::RememberClientUserId), and reports a warning when the two disagree. Until such a
      // userid has been seen (or when the offset is rejected) the placeholder stays unavailable
      // (IdentityUnavailable), exactly like the Metamod original when GetPlayerUserId failed.
      "ClientUserIdOffset": {
        "win64": 168,
        "linuxsteamrt64": 168
      }
      //
      // The remaining offsets of cs2ac.games.txt (GameEntitySystem, Teleport, IsEntityPawn,
      // IsEntityController, ClientOffset, ProcessRespondCvarValue, ClientSlotOffset) belong to the
      // Metamod engine/schema layer; the port reads the same data through s2sdk, so they are not
      // carried over.
    }
  }
}
