{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${CS2AC_VERSION}",
	"name": "cs2ac",
	"description": "CS2AC fork v11 (Metamod CS2AC 1.0.14 + packages v3-v11) - server-side anti-cheat for Counter-Strike 2 by karola3vax, ported from its Metamod:Source plugin to Plugify/s2sdk. Watches the usercmds, movement, aim, shot, input-history and settings data players send to the server and reports and punishes 18 detection categories (aimbot, aimlock, antiaim, autostrafe, bhop, dll injection, desubticking, doubletap, hyperscroll, inhuman accuracy, invalid cvar, invalid input, irregular behavior, namechanger, nulls, silentaim, subtick spam, triggerbot) plus the fork's report-only BACKTRACK, TICK MANIPULATION, INTERP BACKTRACK, MOUSE MISMATCH, TRIGGER PATTERN and RCS telemetry. Usercmd and movement data come from polyhook detours on the gamedata-resolved libserver.so functions, everything else from s2sdk (events, net messages, client cvars, schema). Bans are queued through the optional admin_system API (falling back to the configured command); kicks use the configured kick command. Configuration and translations are the fork's cs2ac.cfg and translations/<lang>.txt. Administrator commands: cs2ac_status, cs2ac_help, cs2ac_reload, cs2ac_check_config, cs2ac_test_announcement, cs2ac_webhook_test, cs2ac_config_loaded, plus the diagnostics cs2ac_hooks and cs2ac_usercmd_dump. Reports go to the server console, chat, center screen, a configurable admin-plugin ban/kick command, the JSONL detection log and an optional Discord webhook. Known port limitations (see PORT_PLAN.md and FORK_SYNC.md): the auto-updater is not ported, the DLL Injection detector stays off unless its vtable index is verified in gamedata, and the usercmd protobuf reader reports through cs2ac_usercmd_dump so it can be confirmed on a live server.",
	"author": "karola3vax, ported to Plugify",
	"website": "https://github.com/karola3vax/CS2AC",
	"license": "AGPL-3.0",
	"entry": "bin/cs2ac",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "polyhook",
			"constraints": ">=2.5.6"
		},
		{
			"name": "admin_system",
			"constraints": ">=1.0.0",
			"optional": true
		}
	]
}
